+
+function trimNoteUrlTail(value) {
+  var token = String(value || '');
+  // Common sentence punctuation should remain plain text after the link.
+  while (/[.,，。;；:：!?！？、"'”’」』]$/.test(token)) token = token.slice(0, -1);
