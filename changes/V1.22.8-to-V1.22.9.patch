+  color:#43c9db; /* fallback for engines without text clipping */
+  /*
+   * The background is deliberately wider than the glyphs. At rest only the first
+   * ice-blue/cyan section is visible. During :active the background position travels
+   * across an off-screen violet + pearl highlight band, then the release snaps back
+   * to the quiet two-color resting state. No line-box/layout properties are animated.
+   */
+  background-image:linear-gradient(100deg,
+    #86e8ff 0%, #26d6c8 36%, #26d6c8 42%,
+    #8f7aff 47%, #f7fdff 52%, #35d9d0 57%,
+    #86e8ff 62%, #26d6c8 100%);
   background-repeat:no-repeat;
-  background-size:100% 100%;
+  background-size:260% 100%;
+  background-position:0% 50%;
   -webkit-background-clip:text;
   background-clip:text;
   -webkit-text-fill-color:transparent;
   text-decoration:underline;
-  text-decoration-color:rgba(63,140,210,.26);
+  text-decoration-color:rgba(40,203,209,.30);
   text-decoration-thickness:1px;
-  text-underline-offset:2px;
+  text-underline-offset:2.5px;
   cursor:pointer;
   overflow-wrap:anywhere;
-  -webkit-tap-highlight-color:rgba(63,140,210,.10);
+  -webkit-tap-highlight-color:rgba(90,220,235,.10);
+  animation:noteHttpLinkReveal 520ms cubic-bezier(.22,.78,.26,1) both;
+  transition:opacity 120ms ease, text-shadow 160ms ease, text-decoration-color 160ms ease;
 }
 .note-editor__body a[href^="http://"]::selection,
 .note-editor__body a[href^="https://"]::selection {
