+  background:rgba(89,216,235,.24);
   color:#26313c;
   -webkit-text-fill-color:#26313c;
+  text-shadow:none;
 }
 .note-editor__body a[href^="http://"]:active,
-.note-editor__body a[href^="https://"]:active { opacity:.66; }
+.note-editor__body a[href^="https://"]:active {
+  opacity:.78;
+  background-position:100% 50%;
+  text-shadow:0 0 9px rgba(246,252,255,.54), 7px 0 12px rgba(146,120,255,.30);
+  text-decoration-color:rgba(146,120,255,.56);
+  transition:background-position 380ms cubic-bezier(.18,.82,.24,1), opacity 120ms ease, text-shadow 150ms ease, text-decoration-color 150ms ease;
+}
+@media (prefers-reduced-motion: reduce) {
+  .note-editor__body a[href^="http://"],
+  .note-editor__body a[href^="https://"],
+  .note-editor__body a[href^="http://"]:visited,
+  .note-editor__body a[href^="https://"]:visited {
+    animation:none;
+    transition:none;
+  }
+  .note-editor__body a[href^="http://"]:active,
+  .note-editor__body a[href^="https://"]:active {
+    background-position:0% 50%;
+    text-shadow:none;
+    text-decoration-color:rgba(40,203,209,.42);
+  }
+}
 
