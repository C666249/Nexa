+
+/* Mode-only controls enter/exit with a shorter shared fade, while the paper background stays calm. */
+::view-transition-group(mode-category),
+::view-transition-group(mode-recycle),
+::view-transition-group(mode-ai),
+::view-transition-group(mode-fab) {
+  animation-duration: 300ms;
+  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+}
+::view-transition-old(mode-category),
+::view-transition-old(mode-recycle),
+::view-transition-old(mode-ai),
+::view-transition-old(mode-fab),
+::view-transition-new(mode-category),
+::view-transition-new(mode-recycle),
+::view-transition-new(mode-ai),
+::view-transition-new(mode-fab) {
+  mix-blend-mode: normal;
+}
+
+/* During a real header swipe the current page follows the finger a little, then the transition carries that momentum. */
+.app.mode-swipe-preview {
+  will-change: transform, opacity;
