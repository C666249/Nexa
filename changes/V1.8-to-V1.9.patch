+/* ===== To-Do / Note mode transition: native-like layered spring slide ===== */
+/*
+ * V1.9 motion design:
+ * - same-document View Transition API where Chromium/WebView supports it;
+ * - simultaneous old/new snapshots, so there is no blank "fade-out then fade-in" frame;
+ * - transform + opacity only on the main shell for compositor-friendly motion;
+ * - slightly different old/new distances create a restrained parallax/depth feel;
+ * - WAAPI fallback remains for older WebView builds.
+ */
+.app { view-transition-name: mode-shell; }
+#categoryBar { view-transition-name: mode-category; }
+#fabRecycle { view-transition-name: mode-recycle; }
+#fabAi { view-transition-name: mode-ai; }
+#fab { view-transition-name: mode-fab; }
+
+::view-transition-group(mode-shell) {
+  animation-duration: 380ms;
+  animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
+}
+::view-transition-image-pair(mode-shell) { isolation: isolate; }
+::view-transition-old(mode-shell),
+::view-transition-new(mode-shell) {
+  mix-blend-mode: normal;
+  backface-visibility: hidden;
+  transform-origin: 50% 14%;
+}
+
+/* A rightward user gesture reveals the incoming mode from the left. */
+html.mode-vt-right::view-transition-old(mode-shell) {
+  animation: modeShellOldRight 300ms cubic-bezier(0.4, 0, 0.2, 1) both;
+}
+html.mode-vt-right::view-transition-new(mode-shell) {
+  animation: modeShellNewRight 380ms cubic-bezier(0.16, 1, 0.3, 1) both;
+}
+html.mode-vt-left::view-transition-old(mode-shell) {
+  animation: modeShellOldLeft 300ms cubic-bezier(0.4, 0, 0.2, 1) both;
+}
+html.mode-vt-left::view-transition-new(mode-shell) {
+  animation: modeShellNewLeft 380ms cubic-bezier(0.16, 1, 0.3, 1) both;
+}
+
+@keyframes modeShellOldRight {
+  from { opacity: 1; transform: translate3d(0,0,0) scale(1); }
+  to   { opacity: 0.30; transform: translate3d(18px,0,0) scale(0.992); }
+}
+@keyframes modeShellNewRight {
+  from { opacity: 0.42; transform: translate3d(-24px,0,0) scale(0.988); }
+  72%  { opacity: 1; transform: translate3d(1.5px,0,0) scale(1.001); }
+  to   { opacity: 1; transform: translate3d(0,0,0) scale(1); }
+}
+@keyframes modeShellOldLeft {
+  from { opacity: 1; transform: translate3d(0,0,0) scale(1); }
+  to   { opacity: 0.30; transform: translate3d(-18px,0,0) scale(0.992); }
