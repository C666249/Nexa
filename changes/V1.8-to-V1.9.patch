-  .app.mode-page-exit-right, .app.mode-page-enter-right,
-  .app.mode-page-exit-left, .app.mode-page-enter-left { animation-duration: 0.01ms; }
+  ::view-transition-group(mode-shell),
+  ::view-transition-group(mode-category),
+  ::view-transition-group(mode-recycle),
+  ::view-transition-group(mode-ai),
+  ::view-transition-group(mode-fab) { animation-duration: 0.01ms; }
