+                MotionEvent.ACTION_DOWN -> {
+                    lastX = event.x
+                    lastY = event.y
+                    downX = event.x
+                    downY = event.y
+                    downTime = event.eventTime
+                    if (nestedInVerticalScroll && isZoomed()) parent?.requestDisallowInterceptTouchEvent(true)
+                }
