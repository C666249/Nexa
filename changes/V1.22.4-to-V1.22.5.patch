+                MotionEvent.ACTION_UP -> {
+                    if (nestedInVerticalScroll) {
+                        if (zoom <= 1.01f) fitCenter()
+                    } else {
+                        val quickTap = event.eventTime - downTime < 220L &&
+                            kotlin.math.abs(event.x - downX) < 15f &&
