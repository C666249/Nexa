--- todo_v114_base/android/app/src/main/java/com/todolist/app/ui/SnoozeSwipeBannerView.kt	1970-01-01 00:00:00.000000000 +0000
+++ todo_v115_work/android/app/src/main/java/com/todolist/app/ui/SnoozeSwipeBannerView.kt	2026-08-12 04:50:45.064328499 +0000
@@ -0,0 +1,241 @@
+package com.todolist.app.ui
+
+import android.content.Context
+import android.graphics.Color
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.view.Gravity
+import android.view.HapticFeedbackConstants
+import android.view.MotionEvent
+import android.view.ViewConfiguration
+import android.widget.FrameLayout
+import android.widget.TextView
+import kotlin.math.abs
+import kotlin.math.max
+import kotlin.math.min
+
+/**
+ * Shared physical right-swipe interaction for reminder banners.
+ *  - short drag: spring back
+ *  - >=18% width: +5 min
+ *  - >=38% width: +10 min
+ * The banner remains visually one line at rest; snooze actions exist only while dragging.
+ */
+abstract class SnoozeSwipeBannerView(context: Context) : FrameLayout(context) {
+
+    private val density = context.resources.displayMetrics.density
+    private val touchSlop = ViewConfiguration.get(context).scaledTouchSlop
+    protected val cardSurface = FrameLayout(context)
+    private val snoozeHint = TextView(context)
+
+    var onSnooze: ((Int) -> Unit)? = null
+
+    private var downX = 0f
+    private var downY = 0f
+    private var dragging = false
+    private var blockedVertical = false
+    private var currentLevel = 0
+    private var committed = false
+
+    protected fun dp(v: Float) = (v * density).toInt()
+    protected fun dpf(v: Float) = v * density
+
+    init {
+        clipChildren = true
+        clipToPadding = true
+        setBackgroundColor(Color.TRANSPARENT)
+
+        val underlay = FrameLayout(context).apply {
+            background = GradientDrawable(
+                GradientDrawable.Orientation.LEFT_RIGHT,
+                intArrayOf(Color.parseColor("#EEF9F5"), Color.parseColor("#EEF6FA"))
+            ).apply {
+                cornerRadius = dpf(18f)
+                setStroke(dp(1f), Color.parseColor("#DDEEE8"))
+            }
+        }
+        addView(underlay, FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT))
+
+        snoozeHint.apply {
+            text = "+5 min"
+            textSize = 12.5f
+            typeface = Typeface.DEFAULT_BOLD
+            setTextColor(Color.parseColor("#36A98D"))
+            gravity = Gravity.CENTER
+            alpha = 0f
+            includeFontPadding = false
+        }
+        underlay.addView(snoozeHint, FrameLayout.LayoutParams(dp(92f), FrameLayout.LayoutParams.MATCH_PARENT, Gravity.START))
+
+        applySurfaceAccent(0)
+        cardSurface.elevation = dpf(10f)
+        addView(cardSurface, FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.WRAP_CONTENT))
+        isClickable = true
+    }
+
+    protected fun setCardPadding(left: Float, top: Float, right: Float, bottom: Float) {
+        cardSurface.setPadding(dp(left), dp(top), dp(right), dp(bottom))
+    }
+
+    protected fun setCardElevation(dpValue: Float) {
+        cardSurface.elevation = dpf(dpValue)
+    }
+
+    override fun onInterceptTouchEvent(ev: MotionEvent): Boolean {
+        if (committed) return true
+        when (ev.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                downX = ev.x
+                downY = ev.y
+                dragging = false
+                blockedVertical = false
+                currentLevel = 0
+                cardSurface.animate().cancel()
+                return false
+            }
+            MotionEvent.ACTION_MOVE -> {
+                val dx = ev.x - downX
+                val dy = ev.y - downY
+                if (!dragging && !blockedVertical && (abs(dx) > touchSlop || abs(dy) > touchSlop)) {
+                    if (dx > 0f && abs(dx) > abs(dy) * 1.12f) {
+                        dragging = true
+                        parent?.requestDisallowInterceptTouchEvent(true)
+                        return true
+                    }
+                    if (abs(dy) >= abs(dx)) blockedVertical = true
+                }
+            }
+        }
+        return dragging
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        if (committed) return true
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                downX = event.x
+                downY = event.y
+                return true
+            }
+            MotionEvent.ACTION_MOVE -> {
+                val rawDx = max(0f, event.x - downX)
+                if (!dragging) {
+                    val dy = event.y - downY
+                    if (rawDx > touchSlop && rawDx > abs(dy) * 1.12f) dragging = true else return true
+                }
+                updateDrag(rawDx)
+                return true
+            }
+            MotionEvent.ACTION_UP -> {
+                if (!dragging) {
+                    resetVisuals(animated = true)
+                    return false
+                }
+                val level = levelForDistance(max(0f, event.x - downX))
+                if (level == 5 || level == 10) commitSnooze(level) else resetVisuals(animated = true)
+                dragging = false
+                parent?.requestDisallowInterceptTouchEvent(false)
+                return true
+            }
+            MotionEvent.ACTION_CANCEL -> {
+                dragging = false
+                resetVisuals(animated = true)
+                parent?.requestDisallowInterceptTouchEvent(false)
+                return true
+            }
+        }
+        return super.onTouchEvent(event)
+    }
+
+    private fun applySurfaceAccent(level: Int) {
+        val stroke = when (level) {
+            10 -> "#CFE7F0"
+            5 -> "#D2ECE3"
+            else -> "#EEE7DE"
+        }
+        cardSurface.background = GradientDrawable().apply {
+            setColor(Color.parseColor("#FFFEFB"))
+            cornerRadius = dpf(18f)
+            setStroke(dp(1f).coerceAtLeast(1), Color.parseColor(stroke))
+        }
+    }
+
+    private fun updateDrag(rawDx: Float) {
+        val w = width.takeIf { it > 0 }?.toFloat() ?: return
+        // Near-linear first, then a mild resistance so +10 min feels deliberate rather than twitchy.
+        val cap = w * 0.62f
+        val resisted = if (rawDx <= cap) rawDx else cap + (rawDx - cap) * 0.22f
+        cardSurface.translationX = min(resisted, w * 0.78f)
+
+        val nextLevel = levelForDistance(rawDx)
+        if (nextLevel != currentLevel) {
+            currentLevel = nextLevel
+            applySurfaceAccent(nextLevel)
+            if (nextLevel != 0) performHapticFeedback(HapticFeedbackConstants.CLOCK_TICK)
+        }
+
+        when (nextLevel) {
+            10 -> {
+                snoozeHint.text = "+10 min"
+                snoozeHint.setTextColor(Color.parseColor("#318DB1"))
+                snoozeHint.alpha = 1f
+                snoozeHint.scaleX = 1.04f
+                snoozeHint.scaleY = 1.04f
+            }
+            5 -> {
+                snoozeHint.text = "+5 min"
+                snoozeHint.setTextColor(Color.parseColor("#32A587"))
+                snoozeHint.alpha = 1f
+                snoozeHint.scaleX = 1f
+                snoozeHint.scaleY = 1f
+            }
+            else -> {
+                snoozeHint.text = "右滑延后"
+                snoozeHint.setTextColor(Color.parseColor("#8EA89F"))
+                snoozeHint.alpha = min(0.72f, rawDx / max(1f, w * 0.18f))
+                snoozeHint.scaleX = 0.96f
+                snoozeHint.scaleY = 0.96f
+            }
+        }
+    }
+
+    private fun levelForDistance(distance: Float): Int {
+        val w = width.takeIf { it > 0 }?.toFloat() ?: return 0
+        return when {
+            distance >= w * 0.38f -> 10
+            distance >= w * 0.18f -> 5
+            else -> 0
+        }
+    }
+
+    private fun commitSnooze(minutes: Int) {
+        if (committed) return
+        committed = true
+        val w = width.takeIf { it > 0 }?.toFloat() ?: dpf(360f)
+        snoozeHint.text = "+$minutes min  ✓"
+        snoozeHint.alpha = 1f
+        cardSurface.animate()
+            .translationX(w * 1.04f)
+            .alpha(0.18f)
+            .setDuration(190L)
+            .withEndAction { onSnooze?.invoke(minutes) }
+            .start()
+    }
+
+    private fun resetVisuals(animated: Boolean) {
+        currentLevel = 0
+        applySurfaceAccent(0)
+        if (animated) {
+            cardSurface.animate()
+                .translationX(0f)
+                .alpha(1f)
+                .setDuration(220L)
+                .start()
+            snoozeHint.animate().alpha(0f).setDuration(160L).start()
+        } else {
+            cardSurface.translationX = 0f
+            cardSurface.alpha = 1f
+            snoozeHint.alpha = 0f
+        }
+    }
+}
