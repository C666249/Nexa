+    activeTarget = el;
+    coach.classList.add('active');
+    try { if (navigator.vibrate) navigator.vibrate(10); } catch(e) {}
+    return true;
+  }
+
+  function close(mark=true) {
+    const coach = document.getElementById('contextCoach');
+    if (!coach) return;
+    if (mark && activeKey) markSeen(activeKey);
+    activeKey = '';
+    activeTarget = null;
